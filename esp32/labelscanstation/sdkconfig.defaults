CONFIG_USB_OTG_SUPPORTED=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_USB_HOST_EXT_PORT_RESET_ATTEMPTS=5
CONFIG_USB_HOST_EXT_PORT_RESET_RECOVERY_DELAY_MS=100
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_COMPILER_WARN_WRITE_STRINGS=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# Build for size (was DEBUG/-Og by default)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Default + maximum runtime log level = DEBUG (was INFO).
# MAXIMUM must be >= DEFAULT or higher-level calls are compiled out.
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Quad PSRAM (e.g. ESP32-S3-WROOM-1 N*R2). IGNORE_NOTFOUND=y so a board
# without PSRAM still boots. ALWAYSINTERNAL=16384 keeps small/hot allocs in
# internal DRAM; only large buffers spill to PSRAM. WiFi/LWIP must stay in
# internal DRAM for DMA, hence TRY_ALLOCATE_WIFI_LWIP=n.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
